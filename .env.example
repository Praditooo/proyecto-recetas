# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.

# --- Aplicación ---
# Genera una clave con: openssl rand -hex 32
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Base de datos ---
# Docker Compose construye DATABASE_URL a partir de estas tres variables.
# Evita caracteres especiales (@ : / #) en la contraseña o codifícalos en la URL.
POSTGRES_USER=recetas_user
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=recetas_db

# Solo para ejecutar la app localmente sin Docker (descomenta y ajusta):
# DATABASE_URL=postgresql+psycopg2://recetas_user:cambia-esta-contrasena@localhost:5432/recetas_db

# --- Proveedor LLM (OpenRouter, Groq, Together AI u otro compatible con /chat/completions) ---
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Verifica en el catálogo del proveedor que el modelo siga disponible.
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_TIMEOUT_SECONDS=45

# --- Despliegue en VPS (Caddy gestiona HTTPS con Let's Encrypt) ---
DOMAIN=recetas.example.com
